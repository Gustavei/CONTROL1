rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Test connection check
    match /test/{testId} {
      allow read, write: if true;
    }

    // Routes collection - Permitted for operations and real-time synchronization
    match /routes/{routeId} {
      allow read, write: if true;
    }

    // Drivers collection - Permitted for provider driver rosters
    match /drivers/{driverId} {
      allow read, write: if true;
    }

    // Vehicles / Furgonetas collection
    match /vehicles/{vehicleId} {
      allow read, write: if true;
    }

    // Fuel logs collection
    match /fuel_logs/{logId} {
      allow read, write: if true;
    }

    // Maintenance logs collection
    match /maintenance_logs/{logId} {
      allow read, write: if true;
    }

    // Mileage logs collection
    match /mileage_logs/{logId} {
      allow read, write: if true;
    }

    // System Settings collection
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Admins registry
    match /admins/{adminId} {
      allow read, write: if true;
    }
  }
}
